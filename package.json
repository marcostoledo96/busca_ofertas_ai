{
  "name": "busca-ofertas-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:boundaries": "depcruise --config dependency-cruiser.config.cjs packages apps adapters tests",
    "typecheck": "tsc -b",
    "pretest": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf packages/*/dist tests/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@busca-ofertas-ai/core": "workspace:*",
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
}
